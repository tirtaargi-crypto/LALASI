<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/lalasi_launch_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_blank</item>
        <item name="windowSplashScreenAnimationDuration">0</item>
        <item name="android:windowBackground">@color/lalasi_launch_background</item>
        <item name="postSplashScreenTheme">@style/Theme.lalasi</item>
    </style>

    <!-- the anime icons' splash, only told apart on android 12+ (values-v31) -->
    <style name="Theme.App.Starting.Icon" parent="Theme.App.Starting" />

    <!-- light theme: applied with SplashScreen.setSplashScreenTheme (android 13+), see AppIcons.syncSplash -->
    <style name="Theme.App.Starting.Light" parent="Theme.App.Starting">
        <item name="windowSplashScreenBackground">@color/lalasi_launch_background_light</item>
        <item name="android:windowBackground">@color/lalasi_launch_background_light</item>
    </style>

    <style name="Theme.lalasi" parent="android:Theme.Material.NoActionBar">
        <item name="android:fontFamily">@font/inter</item>
        <item name="fontFamily">@font/inter</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowMinWidthMinor">100%</item>
        <item name="android:windowMinWidthMajor">100%</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@color/window_background</item>
        <item name="android:enforceNavigationBarContrast" tools:ignore="NewApi">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- Widget Theme with Material 3 colors fallback for API < 31 -->
    <style name="Theme.Widget.lalasi" parent="@android:style/Theme.DeviceDefault">
        <item name="android:fontFamily">@font/inter</item>
        <item name="fontFamily">@font/inter</item>
        <item name="android:colorBackground">#E6E1E5</item>
    </style>
</resources>
