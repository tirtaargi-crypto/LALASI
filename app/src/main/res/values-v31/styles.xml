<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Use a padded transparent wordmark asset; the launcher icon must never appear in the splash. -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="android:windowSplashScreenBackground">#050505</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/lalasi_splash_brand</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@android:color/transparent</item>
        <item name="postSplashScreenTheme">@style/Theme.mochy</item>
    </style>

    <style name="Theme.App.Starting.Icon" parent="Theme.App.Starting" />

    <!-- Widget Theme for Android 12+ with Dynamic Colors -->
    <style name="Theme.Widget.mochy" parent="@android:style/Theme.DeviceDefault.DayNight">
        <item name="android:fontFamily">@font/inter</item>
        <item name="fontFamily">@font/inter</item>
    </style>
</resources>
