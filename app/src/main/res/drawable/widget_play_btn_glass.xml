<?xml version="1.0" encoding="utf-8"?>
<!-- Primary Play/Pause: brighter liquid-glass disc with a curved top highlight and a cool glow underneath. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true"><layer-list>
        <item><shape android:shape="oval"><solid android:color="#80FFFFFF" /></shape></item>
        <item><shape android:shape="oval"><stroke android:width="1dp" android:color="#E6FFFFFF" /></shape></item>
    </layer-list></item>
    <item><layer-list>
        <item><shape android:shape="oval"><gradient android:angle="270" android:startColor="#66FFFFFF" android:endColor="#26FFFFFF" /></shape></item>
        <item><inset android:insetLeft="15%" android:insetRight="15%" android:insetTop="5%" android:insetBottom="52%">
            <shape android:shape="oval"><gradient android:angle="270" android:startColor="#99FFFFFF" android:endColor="#00FFFFFF" /></shape>
        </inset></item>
        <item><inset android:insetLeft="22%" android:insetRight="22%" android:insetTop="62%" android:insetBottom="6%">
            <shape android:shape="oval"><gradient android:angle="90" android:startColor="#42BFE4FF" android:endColor="#00BFE4FF" /></shape>
        </inset></item>
        <item><shape android:shape="oval"><stroke android:width="1.2dp" android:color="#A6FFFFFF" /></shape></item>
        <item><inset android:insetLeft="1.8dp" android:insetRight="1.8dp" android:insetTop="1.8dp" android:insetBottom="1.8dp">
            <shape android:shape="oval"><stroke android:width="0.5dp" android:color="#33A8D8FF" /></shape>
        </inset></item>
    </layer-list></item>
</selector>
